# Uvicorn configuration
uvicorn:
  reload: true
  port: 8001
  host: 0.0.0.0
  ssl_certfile: /etc/linuxmuster/api/lmnapi.pem
  ssl_keyfile: /etc/linuxmuster/api/lmnapi.pem
  log_level: info
  log_config: /etc/linuxmuster/api/log_conf.yaml
# Secret key used to encode and decode the JWT
secret: LONG_AND_SECURE_BASE64_ENCODED_STRING
# Enable host key auth or not (default to false)
host_key_auth: false
host_keys:
  my_server: # Name of the key
    ips: [127.0.0.1, 192.168.1.1] # List of ips allowed
    user: global-admin # cn of a valid ldap user to isolate the permissions
    secret: LONG_AND_SECURE_BASE64_ENCODED_STRING
  my_server2: # Name of the key
    ips: [] # All ip allowed
    user: lmn-teacher # cn of a valid ldap user to isolate the permissions
    secret: LONG_AND_SECURE_BASE64_ENCODED_STRING
# Job-completion webhook, sent when a background sophomorix job started via
# /listmanagement/sophomorix-check or /listmanagement/sophomorix-apply finishes.
# Omit this section entirely to disable notifications (polling the job's
# /listmanagement/sophomorix-apply/status/{pid} endpoint still works).
notifications:
  callback_url: https://url.example/hooks/lmnapi
  key: PUBLIC_KEY_IDENTIFIER # sent as-is in the x-webhook-key header, lets the receiver pick which secret to verify with
  secret: LONG_AND_SECURE_BASE64_ENCODED_STRING # used to sign x-webhook-signature, never sent over the wire
  timeout: 5 # seconds, best-effort: a failed/slow callback only logs a warning
# CORS configuration
cors:
  allow_origins:
    - http://example.net
    - https://localhost:8001
  allow_credentials: true
  allow_methods: 
    - GET
    - POST
  allow_headers: ['*']

